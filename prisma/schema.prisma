generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  locale    String   @default("fr-FR")
  timezone  String   @default("Europe/Paris")
  currency  String   @default("EUR")
  createdAt DateTime @default(now())

  // Phase 0.7 — truly universal settings only. Surfaced as a single
  // editor at /admin/parametres. Every billing-flavored field (trial
  // fee, recurring annual fee, dunning threshold) was removed because
  // each belongs to a more specific concept that doesn't generalize
  // across coaching / therapy / tutoring / wellness / music-school
  // verticals. See drop_billing_settings_from_org migration for the
  // reasoning per field, and the future-work entries in BACKLOG 0.7.
  //
  // What stays: identity (handled by the columns above) + tax rate.
  vatRate Float @default(20) // % tax applied on invoices

  users              User[]
  roles              Role[]
  locations          Location[]
  facilitators       Facilitator[]
  rooms              Room[]
  clients            Client[]
  tags               Tag[]
  services           Service[]
  serviceCategories  ServiceCategory[]
  scheduledEvents    ScheduledEvent[]
  terms              Term[]
  enrollments        Enrollment[]
  closures           Closure[]
  widgets            BookingWidget[]
  slotHolds          SlotHold[]
  payments           Payment[]
  invoices           Invoice[]
  billingIdentities  BillingIdentity[]
  paymentAllocations PaymentAllocation[]
  facilitatorPayouts FacilitatorPayout[]
  widgetSubmissions  WidgetSubmission[]
  enrollmentInvites  EnrollmentInvite[]
  rescheduleTokens   ScheduledEventRescheduleToken[]
  recurrenceSeries   RecurrenceSeries[]
  auditLogEntries    AuditLogEntry[]

  // Phase 2.0 — workflow engine
  widgetFlows        WidgetFlow[]
  widgetRuns         WidgetRun[]
  engineActionEvents EngineActionEvent[]

  // N.4 — one-time / recurring teacher + room unavailability blocks.
  unavailabilities Unavailability[]

  // M — chat center: user ↔ user conversations.
  conversations Conversation[]
  // N — in-app notification center.
  notifications Notification[]
}

model User {
  id           String  @id @default(cuid())
  email        String
  passwordHash String?

  // Phase 0.3: role is now a FK to a per-org Role row carrying a
  // Permission[] array. Nullable so deleting a role doesn't cascade
  // -delete its users (admins reassign instead). The freeform
  // `role` string was dropped by 20260526000000_granular_permissions.
  roleId  String?
  roleRef Role?   @relation(fields: [roleId], references: [id], onDelete: SetNull)

  // Per-user resource-scoped grants — e.g. "this user can EVENT_MANAGE_SCOPED
  // for facilitator-ids [x, y]". Admin-picked at user create/edit time.
  permissionScopes UserPermissionScope[]

  // Phase 0.3: soft-disable (deactivate without losing the row).
  // Login + permission middleware treat a disabled user as
  // unauthenticated. Distinct from trash: a disabled user keeps their
  // roleId/facilitatorId, can be reactivated, and never auto-purges.
  disabledAt   DateTime?
  disabledById String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  facilitatorId  String?      @unique
  facilitator    Facilitator? @relation(fields: [facilitatorId], references: [id])

  // N.9 — per-user UI preferences. Self-service (each user edits their
  // own via /api/users/me/preferences), distinct from org-level
  // OrganizationSettings.locale. Nullable so existing rows keep working
  // and the frontend can fall back to its own defaults (theme: client
  // default; locale: the NEXT_LOCALE cookie / DEFAULT_LOCALE).
  //   - themePreference: a theme key from the admin theme catalog
  //     (e.g. "light", "dark", "dracula", "matrix"). Free-form string;
  //     the frontend validates against its known set and ignores
  //     unknown values, so renaming/removing a theme never 500s here.
  //   - localePreference: a BCP-47-ish locale code ("fr", "en").
  themePreference  String?
  localePreference String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, email])
  @@index([roleId])
  @@index([disabledAt])
}

// =====================================================================
// Phase 0.3 — Granular permission system
// =====================================================================
// Each Organization defines its own Role rows. Three are seeded at org
// creation (Propriétaire / Administrateur / Enseignant) with isSystem
// = true so the UI can't delete them; admins are free to fork additional
// custom roles with any subset of Permission values.
//
// Resource scoping (e.g. "Sarah manages events for facilitators X, Y")
// lives in UserPermissionScope so it's per-user, not per-role — two
// teachers share the Enseignant role but each gets their own scope rows.

enum Permission {
  // Org-level admin
  ADMIN_ACCESS // gates /admin/* surface in the frontend middleware
  ORG_MANAGE
  USER_MANAGE
  ROLE_MANAGE

  // People
  CLIENT_VIEW
  CLIENT_MANAGE
  CLIENT_ANONYMIZE
  FACILITATOR_VIEW
  FACILITATOR_MANAGE

  // Catalog
  SERVICE_MANAGE
  SERVICE_CATEGORY_MANAGE
  LOCATION_MANAGE
  ROOM_MANAGE
  TAG_MANAGE

  // Schedule
  TERM_MANAGE
  CLOSURE_MANAGE
  EVENT_VIEW
  EVENT_MANAGE_ALL // any event in the org
  EVENT_MANAGE_SCOPED // only events on facilitators listed in UserPermissionScope
  EVENT_CANCEL // separate from MANAGE — destructive ops decision, narrower default
  SERIES_MANAGE
  ENROLLMENT_MANAGE

  // Money
  PAYMENT_VIEW
  PAYMENT_MANAGE
  REFUND_ISSUE
  INVOICE_VIEW_ALL // every invoice in the org
  INVOICE_VIEW_SCOPED // only invoices tied to intervenants in UserPermissionScope (+ the user's own linked intervenant)

  // Ops
  ARCHIVE_ACCESS
  TRASH_ACCESS
  PURGE_PERMANENTLY
  AUDIT_LOG_VIEW

  // Widget
  WIDGET_MANAGE

  // M.1 — messaging center. VIEW gates the history + templates surface;
  // SEND gates composing/sending and managing templates.
  MESSAGE_VIEW
  MESSAGE_SEND
}

model Role {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  description String?
  color       String? // hex string for chip rendering
  isSystem    Boolean @default(false) // seeded roles can't be deleted via UI

  permissions Permission[] @default([])

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
}

// Per-user resource-scoped grants. resourceType is loosely typed because
// the FK target could be any of several models (currently only Facilitator
// in v1, but Service / Location / etc. could follow); Postgres can't
// enforce a single FK across multiple tables, so the consistency check
// lives in the app layer.
model UserPermissionScope {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission
  resourceType String // 'Facilitator' for v1
  resourceId   String // not DB-enforced; polymorphic
  createdAt    DateTime   @default(now())

  @@unique([userId, permission, resourceType, resourceId])
  @@index([userId, permission])
}

model Location {
  id               String           @id @default(cuid())
  name             String
  description      String?
  address          String

  // Marketplace (apps/marketplace) — public profile fields.
  photoUrl         String?          // cover image (Cloudinary URL)
  gallery          String[]         @default([]) // additional photos
  latitude         Float?           // from address geocoding (BAN)
  longitude        Float?

  // Contact + virtual-venue fields (surfaced on the admin UID detail panel).
  phone            String?
  email            String?
  isVirtual        Boolean          @default(false)
  virtualLink      String?
  notes            String?

  rooms            Room[]
  facilitators     Facilitator[]    @relation("FacilitatorLocations")
  events           ScheduledEvent[]
  terms            Term[]
  enrollments      Enrollment[]
  closures         Closure[]
  // N.4.8 — location-wide time-of-day blocks (time-precise cousin of Closure).
  unavailabilities Unavailability[]

  // Trash bin (Phase 0.5)
  deletedAt   DateTime?
  deletedById String?

  // Archive (Phase 6.11) — mutually exclusive with trash.
  archivedAt   DateTime?
  archivedById String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([deletedAt])
  @@index([archivedAt])
}

model Facilitator {
  id                String           @id @default(cuid())
  firstname         String
  lastname          String
  email             String
  phone             String
  bio               String?
  address           String?
  profilePictureUrl String?
  color             String
  availability      Json
  notes             String?
  metadata          Json?
  isBookable        Boolean
  isBioDisplayed    Boolean
  locations         Location[]       @relation("FacilitatorLocations")
  tags              Tag[]            @relation("FacilitatorTags")
  events            ScheduledEvent[] @relation("EventFacilitators")
  services          Service[]        @relation("FacilitatorServices")
  enrollments       Enrollment[]
  user              User?
  slotHolds         SlotHold[]
  billingIdentity   BillingIdentity?

  // Phase D — teacher split. Invoice lines whose revenue belongs to this
  // facilitator, and the payment slices allocated to them.
  invoiceLines       InvoiceLine[]
  paymentAllocations PaymentAllocation[]
  // Payouts the org has made to this facilitator (reversements).
  payouts            FacilitatorPayout[]

  // N.4 — time ranges where this facilitator is unbookable.
  unavailabilities Unavailability[]

  // Recommender scoring (consumed by the booking widget's recommender service)
  ageScores      Json     @default("[]") // [{min:number, max:number, score:number}]
  levelScores    Json     @default("{}") // {BEGINNER:number, INTERMEDIATE:number, ADVANCED:number}
  languages      String[] @default([]) // BCP-47 codes (e.g. "fr-FR", "en-US")
  priorityWeight Float    @default(1.0)

  // Teacher-split config (consumed in Phase D). Inert until then.
  //   billingMode    NONE          → no split; the school bills everything.
  //                  BILLS_CLIENT  → the teacher's share is invoiced by the
  //                                  teacher directly to the client.
  //                  BILLS_SCHOOL  → the teacher invoices the school.
  //   splitRuleMode  MANUAL        → per-line amounts entered by hand.
  //                  PERCENTAGE    → splitRuleValue is a % of each line.
  //                  FIXED_PER_SESSION → splitRuleValue is cents/session.
  billingMode    String @default("NONE")
  splitRuleMode  String @default("MANUAL")
  splitRuleValue Int    @default(0)

  // Trash bin (Phase 0.5)
  deletedAt   DateTime?
  deletedById String?

  // Archive (Phase 6.11) — mutually exclusive with trash.
  archivedAt   DateTime?
  archivedById String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Hot path: every facilitator list, recommender.
  @@index([organizationId])
  @@index([deletedAt])
  @@index([archivedAt])
}

model Room {
  id           String           @id @default(cuid())
  name         String
  color        String
  locationId   String
  availability Json
  notes        String?
  metadata     Json?
  location     Location         @relation(fields: [locationId], references: [id])
  events       ScheduledEvent[]
  enrollments  Enrollment[]

  // N.4 — time ranges where this room is blocked.
  unavailabilities Unavailability[]

  // Trash bin (Phase 0.5)
  deletedAt   DateTime?
  deletedById String?

  // Archive (Phase 6.11) — mutually exclusive with trash.
  archivedAt   DateTime?
  archivedById String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, name])
  @@index([deletedAt])
  @@index([archivedAt])
}

model Client {
  id                String             @id @default(cuid())
  firstname         String
  lastname          String
  email             String
  phone             String
  birthdate         DateTime
  address           String
  notes             String?
  metadata          Json?
  events            ScheduledEvent[]   @relation("EventClients")
  enrollments       Enrollment[]
  payments          Payment[]
  invoices          Invoice[]
  enrollmentInvites EnrollmentInvite[]

  // Trash bin (Phase 0.5)
  deletedAt   DateTime?
  deletedById String?

  // Archive (Phase 6.11) — mutually exclusive with trash.
  archivedAt   DateTime?
  archivedById String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Hot path: client list, search, pickers.
  @@index([organizationId])
  @@index([deletedAt])
  @@index([archivedAt])
}

model Tag {
  id           String           @id @default(cuid())
  label        String
  parentId     String?
  metadata     Json?
  facilitators Facilitator[]    @relation("FacilitatorTags")
  events       ScheduledEvent[] @relation("EventTags")
  services     Service[]        @relation("ServiceTags")

  // Trash bin (Phase 0.5)
  deletedAt   DateTime?
  deletedById String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([deletedAt])
}

model Service {
  id                     String           @id @default(cuid())
  name                   String
  description            String
  defaultDurationMinutes Int
  defaultPrice           Float
  notes                  String?
  metadata               Json?
  serviceCategoryId      String
  serviceCategory        ServiceCategory  @relation(fields: [serviceCategoryId], references: [id])
  tags                   Tag[]            @relation("ServiceTags")
  events                 ScheduledEvent[]

  facilitators Facilitator[] @relation("FacilitatorServices")
  enrollments  Enrollment[]

  // Booking mode — drives the widget flow + post-booking behavior:
  //   LESSON   - trial-then-trimester (PAID_TRIAL → enrollment invite email
  //              → second form with trial credit applied)
  //   ONE_OFF  - direct purchase, no trial concept, no enrollment invite
  //              (room rentals, concert tickets, masterclasses, etc.)
  bookingMode String @default("LESSON")

  // Trash bin (Phase 0.5)
  deletedAt   DateTime?
  deletedById String?

  // Archive (Phase 6.11) — mutually exclusive with trash.
  archivedAt   DateTime?
  archivedById String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([deletedAt])
  @@index([archivedAt])
}

model ServiceCategory {
  id             String           @id @default(cuid())
  name           String
  description    String
  isDisplayed    Boolean
  isBookable     Boolean
  services       Service[]
  ScheduledEvent ScheduledEvent[]

  // Trash bin (Phase 0.5)
  deletedAt   DateTime?
  deletedById String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([deletedAt])
}

model ScheduledEvent {
  id        String   @id @default(cuid())
  startTime DateTime
  endTime   DateTime
  color     String
  price     Float
  notes     String?

  // Lifecycle status:
  //   SCHEDULED                     - regular admin-created event
  //   PENDING_PAYMENT               - created via widget, awaiting payment
  //   PAID_TRIAL                    - trial paid, ready to happen
  //   AWAITING_ENROLLMENT_DECISION  - trial done, waiting on enrollment (PR 6)
  //   CONVERTED_TO_ENROLLMENT       - trial converted (PR 6)
  //   LAPSED                        - invite expired without conversion (PR 6)
  //   CANCELED                      - admin-cancelled
  status            String    @default("SCHEDULED")
  rescheduleCount   Int       @default(0)
  originalStartTime DateTime?

  // Phase 1.2 — pre-event reminders.
  // Two stamps so the cron stays idempotent: the worker queries for
  // events in the [now+47h, now+49h] / [now+23h, now+25h] window
  // that still have the matching column null, sends, stamps. A
  // second pass within the same window can't double-send because
  // the stamp is now set.
  // "first" = 48h (earlier in time), "second" = 24h (later in time).
  firstReminderSentAt  DateTime?
  secondReminderSentAt DateTime?

  // Phase 1.1 — cancellation metadata. status='CANCELED' already
  // exists; these columns capture the WHY + WHEN. canceledById is
  // recoverable from the audit log too, but storing inline saves a
  // join on the event-detail cancellation banner.
  canceledAt         DateTime?
  cancellationReason String?
  canceledById       String?

  // Relations
  roomId            String
  locationId        String
  serviceId         String
  serviceCategoryId String

  room            Room            @relation(fields: [roomId], references: [id])
  location        Location        @relation(fields: [locationId], references: [id])
  service         Service         @relation(fields: [serviceId], references: [id])
  serviceCategory ServiceCategory @relation(fields: [serviceCategoryId], references: [id])

  facilitators Facilitator[] @relation("EventFacilitators")
  clients      Client[]      @relation("EventClients")
  tags         Tag[]         @relation("EventTags")

  enrollmentId String?
  enrollment   Enrollment? @relation(fields: [enrollmentId], references: [id])

  // Recurrence series this occurrence belongs to (null = standalone event).
  // Detaching a single occurrence (THIS-scope edit) nulls this column.
  // See docs/RECURRENCE_DESIGN.md.
  seriesId String?
  series   RecurrenceSeries? @relation("SeriesOccurrences", fields: [seriesId], references: [id], onDelete: SetNull)

  payments          Payment[]
  widgetSubmissions WidgetSubmission[]
  enrollmentInvites EnrollmentInvite[]
  rescheduleTokens  ScheduledEventRescheduleToken[]

  // Trash bin (Phase 0.5)
  deletedAt   DateTime?
  deletedById String?

  // Archive (Phase 6.11) — mutually exclusive with trash. Lets the
  // admin retire past events from the active calendar without losing
  // the audit/reporting trail.
  archivedAt   DateTime?
  archivedById String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Performance indexes — see docs/PERF_AUDIT.md
  @@index([organizationId, startTime]) // calendar range, reports
  @@index([status, endTime]) // invite cron's PAID_TRIAL→AWAITING advance
  @@index([locationId, startTime]) // per-location calendar, slot options
  @@index([enrollmentId]) // enrollment → events lookup
  @@index([seriesId]) // series → occurrences fan-out
  @@index([deletedAt]) // trash listing + purge cron
  @@index([archivedAt]) // archive listing
}

// =========================================================================
// RecurrenceSeries — parent row for a group of recurring ScheduledEvents.
// Materialization is eager: every occurrence is a real ScheduledEvent row
// referencing the series via `seriesId`. Detaching (per-occurrence edits)
// nulls the row's seriesId; the series rule itself is immutable except
// for status. See docs/RECURRENCE_DESIGN.md.
// =========================================================================
model RecurrenceSeries {
  id String @id @default(cuid())

  // Rule
  frequency String // WEEKLY | BIWEEKLY | MONTHLY | BIMONTHLY | TRIMESTRAL | SEMIANNUAL | YEARLY
  startDate DateTime // first occurrence start (datetime; time-of-day preserved across steps)
  endDate   DateTime // inclusive last possible occurrence boundary

  // Audit / soft-delete prep
  status String @default("ACTIVE") // ACTIVE | CANCELED

  // Defaults captured at series creation. Per-occurrence edits don't reach
  // back into these — they're just the starting state each materialized row
  // inherited.
  defaultColor      String
  defaultPrice      Float
  defaultNotes      String?
  defaultRoomId     String
  defaultLocationId String
  defaultServiceId  String

  occurrences ScheduledEvent[] @relation("SeriesOccurrences")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Trash bin (Phase 0.5)
  deletedAt   DateTime?
  deletedById String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, startDate])
  @@index([deletedAt])
}

model Term {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments Enrollment[]

  // Trash bin (Phase 0.5)
  deletedAt   DateTime?
  deletedById String?

  // Archive (Phase 6.11) — mutually exclusive with trash.
  archivedAt   DateTime?
  archivedById String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Active-term lookups hit on every checkout / cron tick.
  @@index([locationId, startDate])
  @@index([organizationId, startDate])
  @@index([deletedAt])
  @@index([archivedAt])
}

model Enrollment {
  id String @id @default(cuid())

  // what was bought
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  // who
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  // where / with whom (optional at v1 if you want)
  locationId String
  location   Location @relation(fields: [locationId], references: [id])

  facilitatorId String?
  facilitator   Facilitator? @relation(fields: [facilitatorId], references: [id])

  roomId String
  room   Room   @relation(fields: [roomId], references: [id])

  // billing period (was named "trimester" — terms can be any duration)
  termId String
  term   Term   @relation(fields: [termId], references: [id])

  // Recurrence rule.
  // - frequency drives which other fields the generator uses:
  //     WEEKLY / BIWEEKLY  → weekday + startTime + duration
  //     MONTHLY            → same; "weekday of month" semantics deferred,
  //                          MONTHLY today = "every 4 weeks anchored on
  //                          weekday" (clarify later if monthnumber semantics
  //                          are needed)
  //     DAILY              → startTime + duration (weekday ignored)
  //     CUSTOM             → customDates list (weekday + startDate/endDate
  //                          ignored except for billing-window purposes)
  // - weekday becomes nullable: only WEEKLY / BIWEEKLY / MONTHLY need it.
  // - customDates: JSON array of ISO datetime strings, used only when
  //   frequency = 'CUSTOM'. Each entry is the exact start datetime of
  //   one occurrence.
  frequency       String @default("WEEKLY")
  weekday         Int? // 0..6 — nullable for DAILY / CUSTOM
  startTime       String // "HH:MM" (24h, anchored in org's timezone)
  durationMinutes Int
  customDates     Json? // ISO datetime strings, e.g. ["2026-09-15T17:00:00", ...]

  // active window — for non-CUSTOM frequencies this bounds the
  // recurrence; for CUSTOM it's informational (min/max of customDates).
  startDate DateTime
  endDate   DateTime

  // billing snapshot.
  // pricingStrategy values:
  //   PERIOD_PRORATED  - billed at base × (remaining / total occurrences)
  //   PERIOD_FIXED     - flat term price regardless of remaining occurrences
  //   PER_OCCURRENCE   - billed per occurrence
  // Pre-rename values (TERM_FIXED_PRORATED, TERM_FIXED,
  // TERM_PRORATED_BY_LESSONS) are migrated to the new names by
  // migration `20260602000001_rename_pricing_strategy_values`.
  priceCharged    Float
  pricingStrategy String
  status          String // "DRAFT"|"PAID"|"ACTIVE"|"CANCELED"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events ScheduledEvent[]

  // Trash bin (Phase 0.5)
  deletedAt   DateTime?
  deletedById String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Active-subscribers list, per-client + per-term lookups.
  @@index([organizationId, status])
  @@index([clientId])
  @@index([termId])
  @@index([deletedAt])
}

// =========================================================================
// Unavailability (N.4) — a time range during which a SINGLE target (one
// facilitator OR one room OR one location) is blocked from booking. Used by:
//   - the booking widget's slot suggester (the slot is dropped)
//   - the admin event-create validator (the slot raises a conflict warning)
//   - the room-conflict check on event import
//
// Exactly one of facilitatorId / roomId / locationId is set; the *.service
// layer enforces this — Prisma has no `CHECK` constraint surface. A
// location-wide block cascades to every room (and facilitator booking) AT
// that location during the window, complementing the date-only Closure
// model with time-of-day precision.
//
// Recurrence is delivered by eager materialization: a "every Tuesday morning
// until June" declaration creates N rows in one transaction, all sharing
// `recurrenceGroupId`. Each row is editable on its own (THIS scope); a
// fan-out edit / delete uses the group id (ALL scope). This intentionally
// does NOT reuse RecurrenceSeries — that table is bound to lesson-specific
// defaults (price, color, room, location, service) that don't generalize to
// blocking ranges; making those columns nullable would dilute the lesson
// schema's invariants. The pure generator in domain/recurrence is reused
// instead, so the recurrence RULES are identical to those of lessons.
// =========================================================================
model Unavailability {
  id        String   @id @default(cuid())
  startTime DateTime
  endTime   DateTime

  // Free-text reason (e.g. "Arrêt maladie", "Travaux de la salle"). Surfaced
  // in the tooltip on the calendar block; not used for any logic.
  reason String?

  // Exactly one of these three is set (app-level invariant). Nulls let any
  // target shape be expressed without forcing a sentinel row.
  facilitatorId String?
  facilitator   Facilitator? @relation(fields: [facilitatorId], references: [id])

  roomId String?
  room   Room?   @relation(fields: [roomId], references: [id])

  // Location-wide block: every room (and every facilitator booking) at this
  // location during the window is unavailable. Independent from Closure
  // (which is date-only, multi-day, used for school holidays etc.).
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  // Recurrence — shared id across the materialized siblings of a single
  // declaration. NULL for one-shot blocks. The rule fields are denormalized
  // onto every sibling so each row is self-describing (no parent join just
  // to render a block in the calendar tooltip).
  recurrenceGroupId   String?
  recurrenceFrequency String? // WEEKLY | BIWEEKLY | MONTHLY | BIMONTHLY | TRIMESTRAL | SEMIANNUAL | YEARLY
  recurrenceEndDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Trash bin (Phase 0.5) — soft delete + restore from /admin/corbeille.
  deletedAt   DateTime?
  deletedById String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Indexes — calendar range scan + conflict check.
  @@index([organizationId, startTime])
  @@index([facilitatorId, startTime, endTime])
  @@index([roomId, startTime, endTime])
  @@index([locationId, startTime, endTime])
  @@index([recurrenceGroupId])
  @@index([deletedAt])
}

model Closure {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Trash bin (Phase 0.5)
  deletedAt   DateTime?
  deletedById String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Slot-availability checks scan closures by location + date window.
  @@index([locationId, startDate])
  @@index([startDate, endDate])
  @@index([deletedAt])
}

// =========================================================================
// Booking widget — configurable embeddable widget per school.
// =========================================================================
model BookingWidget {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Human-readable URL part — public widget URL = /widget/<slug>
  slug           String
  publishableKey String   @unique
  allowedOrigins String[] @default([])

  isPublished Boolean @default(false)

  // Services this widget exposes (empty = all org services).
  serviceIds String[] @default([])
  // If set, the widget is scoped to a single location.
  locationId String?

  // Theme + layout + copy + recommenderWeights.
  draftConfig     Json
  publishedConfig Json?

  submissions WidgetSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, slug])
}

// =========================================================================
// Soft-hold on a candidate booking slot.
// =========================================================================
model SlotHold {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  facilitatorId String
  facilitator   Facilitator @relation(fields: [facilitatorId], references: [id])

  startTime DateTime
  endTime   DateTime

  sessionId String

  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([facilitatorId, startTime])
  @@index([expiresAt])
  @@index([organizationId])
}

// =========================================================================
// WidgetSubmission — denormalized record of a user's booking submission.
// Created at the moment the user clicks "pay for trial lesson".
// =========================================================================
model WidgetSubmission {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  widgetId String
  widget   BookingWidget @relation(fields: [widgetId], references: [id])

  // Full payload of what the user submitted (for audit).
  payload Json

  status        String // PENDING | CONFIRMED | REJECTED
  ip            String?
  userAgent     String?
  acceptedCgvAt DateTime?
  cgvVersion    String?

  resultingScheduledEventId String?
  resultingScheduledEvent   ScheduledEvent? @relation(fields: [resultingScheduledEventId], references: [id])

  submittedAt DateTime @default(now())

  @@index([widgetId])
  @@index([organizationId])
}

// =========================================================================
// Payment — one row per Stripe PaymentIntent we create.
// Mirrors Stripe state via webhooks; the source of truth is Stripe.
// =========================================================================
model Payment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  amountCents Int
  currency    String @default("EUR")

  // Null for manually recorded payments (cheque / cash / transfer);
  // only Stripe-webhook rows carry an intent id. @unique still holds —
  // Postgres allows many NULLs in a unique column.
  stripePaymentIntentId String? @unique
  stripeCustomerId      String?

  status  String @default("PENDING") // PENDING | SUCCEEDED | FAILED | REFUNDED
  purpose String // TRIAL_LESSON | ENROLLMENT_BALANCE (extend in PR 6)

  // ── 1.9 multi-tender ──────────────────────────────────────────────
  // How the money arrived. STRIPE rows come from the webhook; every
  // other method is recorded manually by an admin (null intent id).
  method String @default("STRIPE") // STRIPE | CHECK | CASH | BANK_TRANSFER | OTHER

  // Invoice this payment settles. One invoice → many payments
  // (e.g. 3 cheques + 1 cash). Null for legacy rows pre-invoicing.
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  // Manual-payment metadata (null for STRIPE).
  receivedAt DateTime? // when cash/transfer received (or cheque handed over)
  reference  String? // espèces receipt no. / virement reference
  payerName  String? // espèces / virement payer name
  note       String? // free-text admin note

  // Cheque-specific. A cheque is only income once it clears, so the
  // row stays status=PENDING until chequeStatus reaches CASHED.
  chequeNumber        String?
  chequeBank          String?
  chequeDrawerName    String?
  expectedDepositDate DateTime?
  chequeStatus        String? // PENDING_DEPOSIT | DEPOSITED | CASHED

  relatedScheduledEventId String?
  relatedScheduledEvent   ScheduledEvent? @relation(fields: [relatedScheduledEventId], references: [id])
  relatedEnrollmentId     String?

  // Phase D — teacher split. How this payment is divided across the school
  // and any freelance teachers, derived from the settled invoice's lines.
  allocations PaymentAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([clientId])
  @@index([invoiceId])
  // Payments dashboard sorts/filters by createdAt within an org.
  @@index([organizationId, createdAt])
  // "Chèques à déposer" tracker: pending cheques by deposit date.
  @@index([organizationId, chequeStatus, expectedDepositDate])
}

// =========================================================================
// Invoice — billing container (Phase 1.9; foundation for 6.5 invoicing).
// A client is billed via an Invoice with N lines; the total is settled
// by one or more Payments of any tender (card / cheque / cash / transfer).
// `paid` + `balance` are derived from settled payments (status=SUCCEEDED)
// at read time; `status` is recomputed on every payment change.
// =========================================================================
model Invoice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  // Phase C — the BillingIdentity that ISSUES this invoice (the school by
  // default, or a freelance teacher for their share of a split). Drives
  // per-issuer numbering; null only for legacy rows predating Phase C.
  issuerId String?
  issuer   BillingIdentity? @relation("InvoiceIssuer", fields: [issuerId], references: [id])

  // Phase D — split-invoice linkage. When the school splits a lesson with a
  // freelance teacher, a child invoice is spun off (issued by the teacher's
  // BillingIdentity) for the teacher's share; it points back to the school's
  // source invoice here. The source invoice exposes them via childInvoices.
  parentInvoiceId String?
  parentInvoice   Invoice?  @relation("InvoiceSplit", fields: [parentInvoiceId], references: [id])
  childInvoices   Invoice[] @relation("InvoiceSplit")

  // Phase D — who the invoice is addressed to. CLIENT (default) bills the end
  // client; SCHOOL bills the org itself — used when a freelance teacher in
  // BILLS_SCHOOL mode invoices the school for their share. clientId still
  // records the underlying lesson's client for traceability.
  billToType String @default("CLIENT") // CLIENT | SCHOOL

  // Human-friendly sequential number, e.g. "2026-0001" (or
  // "<prefix>-2026-0001" when the issuer sets a prefix). Phase C makes the
  // counter PER-ISSUER: each BillingIdentity keeps its own gap-free yearly
  // sequence, unique per (org, issuer).
  number String

  // DRAFT | SENT | PARTIALLY_PAID | PAID | VOID
  status String @default("DRAFT")

  currency String @default("EUR")

  // Money snapshot, recomputed from lines on write so list queries
  // don't aggregate lines. HT = subtotal, TVA = vat, TTC = total.
  // Payments settle against `totalCents`.
  //
  // Phase B — `vatRate` is the invoice-level DEFAULT rate applied to every
  // line that has no per-line override. Seeded from org.vatRate on create
  // but editable per invoice. `vatCents` is the SUM of per-line VAT.
  subtotalCents Int   @default(0)
  vatRate       Float @default(0)
  vatCents      Int   @default(0)
  totalCents    Int   @default(0)

  issueDate DateTime?
  dueDate   DateTime?
  notes     String?

  lines       InvoiceLine[]
  payments    Payment[]
  allocations PaymentAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, issuerId, number])
  @@index([organizationId])
  @@index([clientId])
  @@index([issuerId])
  @@index([parentInvoiceId])
  @@index([organizationId, status])
}

model InvoiceLine {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  description    String
  quantity       Int    @default(1)
  unitPriceCents Int
  amountCents    Int // quantity * unitPriceCents, stored

  // Phase B — per-line VAT. `vatRate` is an OPTIONAL override; null means
  // "inherit the invoice's default vatRate". `vatCents` is this line's VAT
  // (round(amountCents * effectiveRate / 100)), stored so a mixed-rate
  // invoice can print a per-rate VAT breakdown without recomputing.
  vatRate  Float?
  vatCents Int    @default(0)

  // Optional link to the enrollment this line bills for. Kept loose
  // (no FK) to mirror Payment.relatedEnrollmentId.
  enrollmentId String?

  // Phase D — teacher split. The revenue owner of this line: null = the
  // school's own line; set = a freelance teacher whose share this line
  // represents. Drives split-invoice generation and payment allocation.
  facilitatorId String?
  facilitator   Facilitator? @relation(fields: [facilitatorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([facilitatorId])
}

// =========================================================================
// PaymentAllocation — Phase D teacher split. Splits a settled Payment into
// the shares owed to each beneficiary (the school and/or freelance teachers),
// derived from the settling invoice's per-line ownership (InvoiceLine.
// facilitatorId). One payment → N allocations that sum to the payment amount.
// Lets the school see, per teacher, how much collected money is destined for
// that teacher's payout. NOT tenant-scoped in the Prisma extension (like
// Payment): PaymentService sets organizationId explicitly.
// =========================================================================
model PaymentAllocation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  // Phase D — the invoice that governs this split. Nullable since the
  // direct-allocation feature: an allocation can also be recorded straight
  // against a payment with NO invoice ("encaissé pour le compte de" an
  // intervenant, for any tender), recording money the org owes them.
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // SCHOOL | FACILITATOR — whose share this slice of the payment is.
  beneficiaryType String
  facilitatorId   String?
  facilitator     Facilitator? @relation(fields: [facilitatorId], references: [id])

  amountCents Int

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([paymentId])
  @@index([invoiceId])
  @@index([facilitatorId])
  @@index([organizationId, beneficiaryType])
}

// =========================================================================
// FacilitatorPayout — a reversement: money the org pays OUT to a freelance
// facilitator to settle what it collected on their behalf (the "reste dû"
// on /admin/soldes-intervenants). Independent of the invoice/payment loop:
// teacherBalances sums these into paidOutCents so a payout reduces what is
// still owed. `method` mirrors the manual tenders plus STRIPE; a STRIPE
// payout is a Stripe Connect transfer to the facilitator's connected
// account (BillingIdentity.stripeAccountId) and records its transfer id.
// =========================================================================
model FacilitatorPayout {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  facilitatorId String
  facilitator   Facilitator @relation(fields: [facilitatorId], references: [id])

  amountCents Int
  currency    String @default("EUR")

  // CASH | CHECK | BANK_TRANSFER | STRIPE | OTHER
  method    String
  reference String?
  note      String?

  // When the payout actually happened (admin-entered; defaults to now).
  paidAt DateTime @default(now())

  // Stripe Connect transfer id (tr_…), set only when method = STRIPE.
  stripeTransferId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([facilitatorId])
  @@index([organizationId, facilitatorId])
}

// =========================================================================
// BillingIdentity — the legal/fiscal "who is issuing/billing" entity.
// One SCHOOL identity per org (the org itself as an invoicing party) plus
// one optional identity per FACILITATOR (freelancers who emit their own
// invoices for their share of a lesson). Kept as a dedicated table rather
// than inline columns so Organization stays slim (Phase 0.7) and the same
// shape is reused for school + every teacher. Phase C will reference these
// from Invoice.issuerId for per-issuer numbering; Phase E reads the theme
// fields (logoUrl, legalMentions) when rendering the PDF.
// =========================================================================
model BillingIdentity {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // SCHOOL | FACILITATOR. SCHOOL is a per-org singleton enforced in the
  // service layer (facilitatorId is null for it). FACILITATOR rows are
  // 1:1 with a facilitator via the @unique FK below.
  ownerType     String
  facilitatorId String?      @unique
  facilitator   Facilitator? @relation(fields: [facilitatorId], references: [id])

  // Phase C — invoices this identity has issued (per-issuer numbering).
  invoices Invoice[] @relation("InvoiceIssuer")

  // Legal identity printed on the invoice header.
  legalName String
  legalForm String? // "Association loi 1901" | "Auto-entrepreneur" | "SARL" ...
  email     String?
  phone     String?

  addressLine1 String?
  addressLine2 String?
  postalCode   String?
  city         String?
  country      String? @default("France")

  // Fiscal identifiers (FR). Optional because a brand-new identity may be
  // filled in progressively, and micro-entrepreneurs may lack some.
  siret     String?
  vatNumber String? // TVA intracommunautaire
  rcs       String?

  // Bank details for the "à régler par virement" footer.
  iban String?
  bic  String?

  // Stripe Connect — the facilitator's connected account id (acct_…). When
  // set, the org can pay this party directly via a Stripe transfer instead of
  // a manual tender (cash/cheque/virement). See FacilitatorPayout.
  stripeAccountId String?

  // Phase C — optional per-issuer invoice-number prefix. When set, this
  // identity's invoices read "<prefix>-2026-0001"; when null they use the
  // plain "2026-0001" namespace. Lets a freelance teacher keep a distinct,
  // gap-free sequence from the school's.
  invoicePrefix String?

  // PDF theming / legal footer (consumed in Phase E).
  logoUrl String?

  // VAT posture. When vatExempt, lines are billed at 0% and the mention
  // below is printed (typical for auto-entrepreneurs / associations).
  vatExempt        Boolean @default(false)
  vatExemptMention String? @default("TVA non applicable, art. 293 B du CGI")
  legalMentions    String?

  // Phase E — per-issuer PDF theme (colors, font, layout toggles, header/
  // footer copy). A flexible JSON blob (cf. BookingWidget.draftConfig) so
  // the theme can evolve without a migration per knob; null = house default.
  // Shape: see InvoicePdfTheme in services/invoice/invoicePdfTheme.ts.
  pdfTheme Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, ownerType])
}

// =========================================================================
// StripeEvent — idempotency log for webhook deliveries.
// NOT tenant-scoped (Stripe events arrive globally; we route by metadata).
// =========================================================================
model StripeEvent {
  id          String    @id // Stripe event id is globally unique
  type        String
  payload     Json
  processedAt DateTime?
  receivedAt  DateTime  @default(now())
}

// =========================================================================
// EnrollmentInvite — single-use token sent by email after a trial lesson
// (LESSON bookingMode only). Lets the student open the "second form" to
// optionally change slot, see the balance with trial credit applied, and
// pay for the full trimester. Consumed when the balance payment succeeds.
// =========================================================================
model EnrollmentInvite {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  scheduledEventId String
  scheduledEvent   ScheduledEvent @relation(fields: [scheduledEventId], references: [id])

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  // Opaque random token used in the email link. Single-use.
  token String @unique

  // PENDING | CONSUMED | EXPIRED | CANCELED
  status String @default("PENDING")

  // Per-invite override of the recurring slot picked at enrollment time.
  // If set, both the quote (getByToken) and activation use these instead of
  // deriving from the trial event. Once-only — UI prevents re-edit.
  overrideWeekday   Int?
  overrideStartTime String?
  rescheduledAt     DateTime?

  expiresAt  DateTime
  sentAt     DateTime?
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([organizationId])
  @@index([scheduledEventId])
  @@index([expiresAt])
}

// =========================================================================
// ScheduledEventRescheduleToken — single-use opaque token, sent in the
// trial-confirmation email. Lets the student open the reschedule page for
// one specific event. Server-side rules (≤1 reschedule, ≥48h before) are
// enforced on apply — the token alone is not authorization to reschedule
// past those windows.
// =========================================================================
model ScheduledEventRescheduleToken {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  scheduledEventId String
  scheduledEvent   ScheduledEvent @relation(fields: [scheduledEventId], references: [id])

  token      String    @unique
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([organizationId])
  @@index([scheduledEventId])
}

// =========================================================================
// AuditLogEntry — one row per meaningful mutation on whitelisted models.
// Foundation for the trash bin + scoped undo (Phase 0.5 / 5.1) and for
// investigation tools ("who deleted X?"). Writes are fire-and-forget at
// the call site; a failed audit write must never fail the user's action.
// See docs/AUDIT_LOG_DESIGN.md.
// =========================================================================
model AuditLogEntry {
  id String @id @default(cuid())

  // Who — denormalized so the entry survives the user record being
  // deleted (e.g. former staff). actorId can be null for system /
  // cron / webhook actions; the convention there is to set
  // actorEmail = "system:<job-name>".
  actorId    String?
  actorEmail String?
  actorRole  String?

  // What
  action     String // CREATE | UPDATE | DELETE
  entityType String // ScheduledEvent | Facilitator | ...
  entityId   String

  // State snapshots — JSON of the entity's scalar fields only. Relations
  // are NOT serialized (would balloon size + drift over time). Use the
  // entity-history endpoint to walk forward through changes if needed.
  before Json? // null for CREATE
  after  Json? // null for DELETE

  createdAt DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt]) // recent activity feed
  @@index([entityType, entityId]) // per-entity history
  @@index([actorId]) // "what did this user do?"
}

// ─── Workflow engine (Phase 2.0) ──────────────────────────────────
//
// Commit 1 of Phase 2.0 lands the storage layer for the engine.
// We're shipping the FLOW shape (WidgetFlow + WidgetStep +
// WidgetField), the RUNTIME shape (WidgetRun), the draft/publish
// split (WidgetFlowDraft + WidgetFlowSnapshot), and the metering
// table (EngineActionEvent).
//
// Deferred to later commits — explicitly NOT in this schema:
//   • WidgetAction / WidgetActionKind  → Commit 2.2 (action engine)
//   • WidgetTrigger / TriggerEventName → Commit 2.2 (event bus wiring)
//   • WidgetCron                       → Commit 2.4 (time-based triggers)
//   • WidgetEmailTemplate              → Commit 2.3 (email migration)
//   • CustomFieldDefinition + JSONB    → Commit 2.5a (custom fields)
//
// See artcetera_admin/docs/WORKFLOW_ENGINE_DESIGN.md for the full
// design rationale and how these models compose.

enum WidgetFlowKind {
  // Visitor-driven flow with a public URL. Covers any flow a real
  // person walks through: booking, enrollment, trial signup, contact
  // form, etc. (Renamed from BOOKING in May 2026 — see migration
  // 20260528000007_rename_booking_to_visitor.)
  VISITOR
  EVENT_REACTION // triggered by a lifecycle event, no UI
}

model WidgetFlow {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name           String
  description    String?
  kind           WidgetFlowKind @default(VISITOR)
  isTemplate     Boolean        @default(false) // platform-shipped seed; admin clones
  isPublished    Boolean        @default(false) // VISITOR only; gates the public URL
  publishableKey String?        @unique // VISITOR only; appears in widget URL

  // Versioning — bump on every Publish; old versions retained in
  // WidgetFlowSnapshot for rollback. Active version is the highest.
  version Int @default(1)

  runs      WidgetRun[]
  draft     WidgetFlowDraft?
  snapshots WidgetFlowSnapshot[]

  // ─── Graph engine (v2, the only engine after Phase 3.5) ───────
  // A flow is a directed graph of nodes + edges with entry-point
  // descriptors that fire runs. UI nodes block for visitor input;
  // ACTION nodes execute server-side; WAIT nodes suspend the run
  // (resumed via cron sweeper or token URL).
  //
  // Phase 3.5 retired the legacy WidgetStep / WidgetField /
  // WidgetAction / WidgetTrigger tables along with the v1 flow
  // engine that consumed them.
  nodes            WidgetNode[]
  edges            WidgetEdge[]
  entryPoints      WidgetEntryPoint[]
  resumeTokens     WidgetResumeToken[]
  scheduledResumes WidgetScheduledResume[]

  // Phase 2.2 follow-up — same trash + archive semantics as the rest
  // of the soft-deletable models. Deleting a flow from the editor or
  // list now soft-deletes (deletedAt stamp), recoverable from
  // /admin/corbeille. Archiving (archivedAt) is the "keep forever,
  // just hide" counterpart for retired flows.
  deletedAt    DateTime?
  deletedById  String?
  archivedAt   DateTime?
  archivedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, isPublished])
  @@index([deletedAt])
  @@index([archivedAt])
}

// Phase 3.5 dropped the v1 `WidgetStep` + `WidgetField` models +
// their enums (WidgetStepKind / WidgetFieldKind / WidgetFieldBinding).
// v2 stores steps as `WidgetNode` rows with FORM fields inlined into
// `node.config.fields` (validated app-side by the FORM handler).

model WidgetRun {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  flowId         String
  flow           WidgetFlow   @relation(fields: [flowId], references: [id])

  // All captured values from the visitor's session — `vars.X` namespace.
  vars Json @default("{}")

  // v1 — current STEP id (legacy). Kept during 3.0-3.4 phase window
  // for the old runtime; new runtime uses currentNodeId.
  currentStepId String?

  // Phase 3.0 — v2 graph runtime cursor. The node the run is
  // currently stopped at (or null if COMPLETED / not yet started).
  currentNodeId String?

  // Status union grew in 3.0:
  //   IN_PROGRESS     — actively walking (or about to be picked up)
  //   WAITING_INPUT   — paused at a UI node; visitor hasn't submitted
  //   WAITING_TIME    — paused at a WAIT_DURATION / WAIT_UNTIL node;
  //                     sweeper will resume at nextResumeAt
  //   WAITING_TOKEN   — paused at a WAIT_TOKEN node; external URL click resumes
  //   COMPLETED       — reached an end node (no outgoing edges matched)
  //   ABANDONED       — visitor never came back; future TTL cleanup
  //   ERRORED         — fatal error during execution
  status String

  // Phase 3.0 — when set, the cron sweeper picks this run up at the
  // wall-clock time. Cleared on resume.
  nextResumeAt DateTime?

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  // For analytics: drop-off step, time per step, etc.
  stepHistory Json @default("[]")

  // Idempotency log — one row per submit attempt. Replays return the
  // cached response without re-applying side effects.
  submits WidgetRunSubmit[]

  // Phase 3.0 — pending resume tokens + scheduled resumes for this
  // run. Cascade-delete from WidgetRun.
  resumeTokens     WidgetResumeToken[]
  scheduledResumes WidgetScheduledResume[]

  @@index([organizationId, startedAt])
  @@index([flowId, status])
  @@index([status, nextResumeAt])
}

// Idempotency log for step submissions (Phase 2.0 Commit 2).
//
// Every submitStep() call writes one row identified by a client-provided
// `clientSubmitId` (UUIDv4 generated browser-side). A composite unique
// on (runId, clientSubmitId) rejects double-submits at the DB level —
// the engine catches the conflict and returns the cached response from
// the original submit instead of re-applying side effects.
//
// The `response` Json caches validation errors + the post-submit
// progression marker so retries see the exact same result the first
// call returned. Cached responses are small (<1KB typical); no TTL —
// rows live as long as the parent WidgetRun (Cascade delete).
model WidgetRunSubmit {
  id             String    @id @default(cuid())
  runId          String
  run            WidgetRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  stepId         String
  clientSubmitId String

  // { errors: ValidationError[], advancedToStepId: string | null }
  // See services/engine/types.ts for the shape.
  response Json

  submittedAt DateTime @default(now())

  @@unique([runId, clientSubmitId])
  @@index([runId, stepId])
}

// Draft / Published split (locked 2026-05-26).
//
// WidgetFlow is the source of truth for the LIVE serving state —
// only ever updated via the explicit Publish action, validated
// before write. WidgetFlowDraft is the admin's working copy that
// the editor autosaves to on a 2-3s debounce.
//
// The split solves two problems at once:
//   1. Invalid intermediate states (mid-edit conditional with no
//      children, broken var bindings, etc.) never reach the public
//      widget URL.
//   2. Admins never lose work — autosave fires within seconds of
//      any keystroke.
//
// Publish validates the draft, copies into WidgetFlow, bumps
// `version`, and writes a WidgetFlowSnapshot. Snapshots only happen
// on Publish, not on every autosave, keeping the snapshot table small
// and every snapshot meaningful.
model WidgetFlowDraft {
  id     String     @id @default(cuid())
  flowId String     @unique
  flow   WidgetFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  // Full draft state — serialized in the same shape as a snapshot
  // payload. Single JSON blob rather than normalized rows because
  // we never query INTO the draft; the editor reads it whole.
  payload Json

  updatedAt DateTime @updatedAt
}

model WidgetFlowSnapshot {
  id        String     @id @default(cuid())
  flowId    String
  flow      WidgetFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  version   Int
  // Full serialized flow (steps + actions + crons + templates +
  // triggers) for rollback. JSON blob; no FK relations into the
  // normalized tables.
  payload   Json
  createdAt DateTime   @default(now())

  @@unique([flowId, version])
  @@index([flowId])
}

// Usage metering (locked 2026-05-26).
//
// One row per non-trivial engine action execution. Aggregates feed
// the per-org usage panel in /admin/parametres ("X actions ce mois")
// and the future pricing/quota system (Phase 8). No pricing in v1 —
// purely measurement.
//
// What counts as non-trivial: SEND_EMAIL, ISSUE_REFUND,
// CREATE_SCHEDULED_EVENT, UPDATE_ENTITY, AI generation. Cheap ops
// (variable assignment, condition eval, WAIT) are not logged.
//
// Index strategy: (orgId, executedAt) for daily aggregates,
// (orgId, actionKind, executedAt) for per-kind breakdowns.
model EngineActionEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  flowId String? // null for cron-triggered standalone actions
  runId  String? // null for cron-triggered or event-triggered actions

  actionKind String // SEND_EMAIL | ISSUE_REFUND | ...
  status     String // OK | ERROR | SKIPPED
  durationMs Int    @default(0)

  // Free-text reason on ERROR or SKIPPED. Truncated to 500 chars.
  errorMessage String?

  executedAt DateTime @default(now())

  @@index([organizationId, executedAt])
  @@index([organizationId, actionKind, executedAt])
}

// Phase 3.5 dropped the v1 `WidgetAction` + `WidgetTrigger` models.
// v2 expresses both as `WidgetNode` rows (ACTION-category for the
// former) and `WidgetEntryPoint` rows of kind='event' (for the
// latter), unified under the graph engine in graphRuntime.ts.

// ─── Phase 3.0 — graph engine (v2) ────────────────────────────────
//
// Replaces the WidgetStep / WidgetField / WidgetAction / WidgetTrigger
// quartet with a unified node + edge model. Old tables coexist during
// the 3.0-3.4 phase window for migration safety; Phase 3.5 drops them.

// One node in the flow graph. Categories:
//   UI     — blocks for visitor input (SINGLE_SELECT, FORM, RECAP,
//            TEXT_BLOCK, etc.). FORM nodes embed their fields in
//            `config.fields` (no separate WidgetField table in v2).
//   ACTION — executes server-side (SEND_EMAIL, ISSUE_REFUND, …).
//   WAIT   — suspends the run; resumed externally
//            (WAIT_DURATION via cron sweeper, WAIT_TOKEN via URL).
//
// `kind` is String (not enum) so adding a new node kind is purely
// app-layer work — no schema migration. The handler registry is the
// authoritative whitelist.
//
// `position` (positionX / positionY) is for the canvas editor.
// Defaults to (0, 0) for nodes created via JSON import; the canvas
// auto-layouts unpositioned nodes on first render.
model WidgetNode {
  id     String     @id @default(cuid())
  flowId String
  flow   WidgetFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  kind        String
  label       String
  description String?
  config      Json    @default("{}")

  positionX Float @default(0)
  positionY Float @default(0)

  outgoingEdges    WidgetEdge[]            @relation("EdgeFrom")
  incomingEdges    WidgetEdge[]            @relation("EdgeTo")
  entryPoints      WidgetEntryPoint[]
  resumeTokens     WidgetResumeToken[]
  scheduledResumes WidgetScheduledResume[]

  @@index([flowId])
  @@index([flowId, kind])
}

// Directed edge between two nodes. Multiple outgoing edges from one
// node = a branch; the engine picks the first whose `condition`
// evaluates truthy (in `order`). An edge with no `condition` always
// matches — useful as the catch-all at the end of a branch list.
model WidgetEdge {
  id     String     @id @default(cuid())
  flowId String
  flow   WidgetFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  fromNodeId String
  fromNode   WidgetNode @relation("EdgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNodeId   String
  toNode     WidgetNode @relation("EdgeTo", fields: [toNodeId], references: [id], onDelete: Cascade)

  // Evaluation order for siblings out of the same source node.
  order     Int     @default(0)
  // Optional JSONLogic gate. Null = always match.
  condition Json?
  // Optional human-readable label rendered on the canvas edge.
  label     String?

  @@index([flowId])
  @@index([fromNodeId])
  @@index([toNodeId])
}

// Entry-point descriptor — replaces the legacy WidgetTrigger model.
// Each entry point describes WHERE runs start (which node) and HOW
// (visitor URL, bus event, or cron).
//
//   kind = 'visitor' → BOOKING-style; flow's publishableKey URL hits
//                       this entry. At most one per flow.
//   kind = 'event'   → bus-event; config.eventName + optional filter.
//                       Multiple per flow if listening for several events.
//   kind = 'cron'    → time-based; config.schedule (cron expression).
//                       Multiple per flow for multiple schedules.
model WidgetEntryPoint {
  id     String     @id @default(cuid())
  flowId String
  flow   WidgetFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  kind   String // 'visitor' | 'event' | 'cron'
  config Json   @default("{}")

  entryNodeId String?
  entryNode   WidgetNode? @relation(fields: [entryNodeId], references: [id], onDelete: SetNull)

  @@index([flowId])
  @@index([kind])
}

// Resume token for WAIT_TOKEN nodes. Generated when a run hits a
// WAIT_TOKEN node and stored alongside the email/SMS body that
// references it. The token URL resolves to the run + node, and on
// click the engine resumes from there.
//
// `consumed` flips true on first successful resume — a token is
// single-use (prevents replays). `expiresAt` defaults to 30 days.
model WidgetResumeToken {
  id     String     @id @default(cuid())
  flowId String
  flow   WidgetFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  runId  String
  run    WidgetRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  nodeId String
  node   WidgetNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  expiresAt  DateTime
  consumed   Boolean   @default(false)
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([runId])
  @@index([expiresAt, consumed])
}

// Scheduled resume for WAIT_DURATION / WAIT_UNTIL nodes. The sweeper
// job (Phase 3.2) picks up rows with fireAt <= now() + consumed=false,
// resumes the run from `nodeId`, then flips consumed=true.
model WidgetScheduledResume {
  id     String     @id @default(cuid())
  flowId String
  flow   WidgetFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  runId  String
  run    WidgetRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  nodeId String
  node   WidgetNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  fireAt     DateTime
  consumed   Boolean   @default(false)
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([runId])
  @@index([fireAt, consumed])
}

// =============================================================================
// M — Chat center (user ↔ user messaging)
// =============================================================================

/**
 * A conversation between org users — a 1:1 DM (isGroup = false, exactly
 * two participants) or a named group (isGroup = true). `lastMessageAt`
 * is denormalised so a user's inbox can be ordered "most recent first"
 * without scanning ChatMessage.
 */
model Conversation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  isGroup     Boolean @default(false)
  title       String? // group name; DMs derive their title from the other participant
  createdById String?

  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  participants ConversationParticipant[]
  messages     ChatMessage[]

  @@index([organizationId, lastMessageAt])
}

/**
 * Membership of a user in a conversation. `lastReadAt` drives unread
 * counts: messages newer than it, authored by someone else, are unread.
 */
model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String

  // Group admin flag (the creator); informational for now.
  isAdmin    Boolean   @default(false)
  lastReadAt DateTime?
  joinedAt   DateTime  @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

/** One message in a conversation. */
model ChatMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUserId   String
  body           String       @db.Text
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// =============================================================================
// N — Notification center (in-app admin notifications)
// =============================================================================

/**
 * One in-app notification for one admin user. Emitters fan out a row
 * per recipient at write time (small orgs — simple beats clever).
 * `readAt` null = unread. `linkUrl` is an optional in-app deep link.
 */
model Notification {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String

  type    String // 'ENROLLMENT' | 'PAYMENT' | 'SYSTEM' | ...
  title   String
  body    String? @db.Text
  linkUrl String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}
