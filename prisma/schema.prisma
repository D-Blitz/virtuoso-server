generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  locale    String   @default("fr-FR")
  timezone  String   @default("Europe/Paris")
  currency  String   @default("EUR")
  createdAt DateTime @default(now())

  users             User[]
  locations         Location[]
  facilitators      Facilitator[]
  rooms             Room[]
  clients           Client[]
  tags              Tag[]
  services          Service[]
  serviceCategories ServiceCategory[]
  scheduledEvents   ScheduledEvent[]
  terms             Term[]
  enrollments       Enrollment[]
  closures          Closure[]
  widgets           BookingWidget[]
  slotHolds         SlotHold[]
  payments          Payment[]
  widgetSubmissions WidgetSubmission[]
  enrollmentInvites EnrollmentInvite[]
  rescheduleTokens  ScheduledEventRescheduleToken[]
  recurrenceSeries  RecurrenceSeries[]
}

model User {
  id             String       @id @default(cuid())
  email          String
  passwordHash   String?
  role           String // OWNER | ADMIN | STAFF | FACILITATOR
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  facilitatorId  String?      @unique
  facilitator    Facilitator? @relation(fields: [facilitatorId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, email])
}

model Location {
  id           String           @id @default(cuid())
  name         String
  description  String?
  address      String
  rooms        Room[]
  facilitators Facilitator[]    @relation("FacilitatorLocations")
  events       ScheduledEvent[]
  terms        Term[]
  enrollments  Enrollment[]
  closures     Closure[]

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model Facilitator {
  id                String           @id @default(cuid())
  firstname         String
  lastname          String
  email             String
  phone             String
  bio               String?
  address           String?
  profilePictureUrl String?
  color             String
  availability      Json
  notes             String?
  metadata          Json?
  isBookable        Boolean
  isBioDisplayed    Boolean
  locations         Location[]       @relation("FacilitatorLocations")
  tags              Tag[]            @relation("FacilitatorTags")
  events            ScheduledEvent[] @relation("EventFacilitators")
  services          Service[]        @relation("FacilitatorServices")
  enrollments       Enrollment[]
  user              User?
  slotHolds         SlotHold[]

  // Recommender scoring (consumed by the booking widget's recommender service)
  ageScores      Json     @default("[]") // [{min:number, max:number, score:number}]
  levelScores    Json     @default("{}") // {BEGINNER:number, INTERMEDIATE:number, ADVANCED:number}
  languages      String[] @default([]) // BCP-47 codes (e.g. "fr-FR", "en-US")
  priorityWeight Float    @default(1.0)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Hot path: every facilitator list, recommender.
  @@index([organizationId])
}

model Room {
  id           String           @id @default(cuid())
  name         String
  color        String
  locationId   String
  availability Json
  notes        String?
  metadata     Json?
  location     Location         @relation(fields: [locationId], references: [id])
  events       ScheduledEvent[]
  enrollments  Enrollment[]

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, name])
}

model Client {
  id                String             @id @default(cuid())
  firstname         String
  lastname          String
  email             String
  phone             String
  birthdate         DateTime
  address           String
  notes             String?
  metadata          Json?
  events            ScheduledEvent[]   @relation("EventClients")
  enrollments       Enrollment[]
  payments          Payment[]
  enrollmentInvites EnrollmentInvite[]

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Hot path: client list, search, pickers.
  @@index([organizationId])
}

model Tag {
  id           String           @id @default(cuid())
  label        String
  parentId     String?
  metadata     Json?
  facilitators Facilitator[]    @relation("FacilitatorTags")
  events       ScheduledEvent[] @relation("EventTags")
  services     Service[]        @relation("ServiceTags")

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model Service {
  id                     String           @id @default(cuid())
  name                   String
  description            String
  defaultDurationMinutes Int
  defaultPrice           Float
  notes                  String?
  metadata               Json?
  serviceCategoryId      String
  serviceCategory        ServiceCategory  @relation(fields: [serviceCategoryId], references: [id])
  tags                   Tag[]            @relation("ServiceTags")
  events                 ScheduledEvent[]

  facilitators Facilitator[] @relation("FacilitatorServices")
  enrollments  Enrollment[]

  // Booking mode — drives the widget flow + post-booking behavior:
  //   LESSON   - trial-then-trimester (PAID_TRIAL → enrollment invite email
  //              → second form with trial credit applied)
  //   ONE_OFF  - direct purchase, no trial concept, no enrollment invite
  //              (room rentals, concert tickets, masterclasses, etc.)
  bookingMode String @default("LESSON")

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model ServiceCategory {
  id             String           @id @default(cuid())
  name           String
  description    String
  isDisplayed    Boolean
  isBookable     Boolean
  services       Service[]
  ScheduledEvent ScheduledEvent[]

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model ScheduledEvent {
  id            String    @id @default(cuid())
  startTime     DateTime
  endTime       DateTime
  recurrence    String?
  recurrenceEnd DateTime?
  color         String
  price         Float
  notes         String?

  // Lifecycle status:
  //   SCHEDULED                     - regular admin-created event
  //   PENDING_PAYMENT               - created via widget, awaiting payment
  //   PAID_TRIAL                    - trial paid, ready to happen
  //   AWAITING_ENROLLMENT_DECISION  - trial done, waiting on enrollment (PR 6)
  //   CONVERTED_TO_ENROLLMENT       - trial converted (PR 6)
  //   LAPSED                        - invite expired without conversion (PR 6)
  //   CANCELED                      - admin-cancelled
  status            String    @default("SCHEDULED")
  rescheduleCount   Int       @default(0)
  originalStartTime DateTime?

  // Relations
  roomId            String
  locationId        String
  serviceId         String
  serviceCategoryId String

  room            Room            @relation(fields: [roomId], references: [id])
  location        Location        @relation(fields: [locationId], references: [id])
  service         Service         @relation(fields: [serviceId], references: [id])
  serviceCategory ServiceCategory @relation(fields: [serviceCategoryId], references: [id])

  facilitators Facilitator[] @relation("EventFacilitators")
  clients      Client[]      @relation("EventClients")
  tags         Tag[]         @relation("EventTags")

  enrollmentId String?
  enrollment   Enrollment? @relation(fields: [enrollmentId], references: [id])

  // Recurrence series this occurrence belongs to (null = standalone event).
  // Detaching a single occurrence (THIS-scope edit) nulls this column.
  // See docs/RECURRENCE_DESIGN.md.
  seriesId String?
  series   RecurrenceSeries? @relation("SeriesOccurrences", fields: [seriesId], references: [id], onDelete: SetNull)

  payments          Payment[]
  widgetSubmissions WidgetSubmission[]
  enrollmentInvites EnrollmentInvite[]
  rescheduleTokens  ScheduledEventRescheduleToken[]

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Performance indexes — see docs/PERF_AUDIT.md
  @@index([organizationId, startTime]) // calendar range, reports
  @@index([status, endTime]) // invite cron's PAID_TRIAL→AWAITING advance
  @@index([locationId, startTime]) // per-location calendar, slot options
  @@index([enrollmentId]) // enrollment → events lookup
  @@index([seriesId]) // series → occurrences fan-out
}

// =========================================================================
// RecurrenceSeries — parent row for a group of recurring ScheduledEvents.
// Materialization is eager: every occurrence is a real ScheduledEvent row
// referencing the series via `seriesId`. Detaching (per-occurrence edits)
// nulls the row's seriesId; the series rule itself is immutable except
// for status. See docs/RECURRENCE_DESIGN.md.
// =========================================================================
model RecurrenceSeries {
  id String @id @default(cuid())

  // Rule
  frequency String // WEEKLY | BIWEEKLY | MONTHLY | BIMONTHLY | TRIMESTRAL | SEMIANNUAL | YEARLY
  startDate DateTime // first occurrence start (datetime; time-of-day preserved across steps)
  endDate   DateTime // inclusive last possible occurrence boundary

  // Audit / soft-delete prep
  status String @default("ACTIVE") // ACTIVE | CANCELED

  // Defaults captured at series creation. Per-occurrence edits don't reach
  // back into these — they're just the starting state each materialized row
  // inherited.
  defaultColor      String
  defaultPrice      Float
  defaultNotes      String?
  defaultRoomId     String
  defaultLocationId String
  defaultServiceId  String

  occurrences ScheduledEvent[] @relation("SeriesOccurrences")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, startDate])
}

model Term {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments Enrollment[]

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Active-term lookups hit on every checkout / cron tick.
  @@index([locationId, startDate])
  @@index([organizationId, startDate])
}

model Enrollment {
  id String @id @default(cuid())

  // what was bought
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  // who
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  // where / with whom (optional at v1 if you want)
  locationId String
  location   Location @relation(fields: [locationId], references: [id])

  facilitatorId String?
  facilitator   Facilitator? @relation(fields: [facilitatorId], references: [id])

  roomId String
  room   Room   @relation(fields: [roomId], references: [id])

  // which trimester
  termId String
  term   Term   @relation(fields: [termId], references: [id])

  // recurrence rule (weekly)
  weekday         Int // 0..6
  startTime       String // "17:00" (easy v1)
  durationMinutes Int

  // active window
  startDate DateTime
  endDate   DateTime

  // billing snapshot
  priceCharged    Float
  pricingStrategy String // "TERM_FIXED_PRORATED" etc.
  status          String // "DRAFT"|"PAID"|"ACTIVE"|"CANCELED"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events ScheduledEvent[]

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Active-subscribers list, per-client + per-term lookups.
  @@index([organizationId, status])
  @@index([clientId])
  @@index([termId])
}

model Closure {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Slot-availability checks scan closures by location + date window.
  @@index([locationId, startDate])
  @@index([startDate, endDate])
}

// =========================================================================
// Booking widget — configurable embeddable widget per school.
// =========================================================================
model BookingWidget {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Human-readable URL part — public widget URL = /widget/<slug>
  slug           String
  publishableKey String   @unique
  allowedOrigins String[] @default([])

  isPublished Boolean @default(false)

  // Services this widget exposes (empty = all org services).
  serviceIds String[] @default([])
  // If set, the widget is scoped to a single location.
  locationId String?

  // Theme + layout + copy + recommenderWeights.
  draftConfig     Json
  publishedConfig Json?

  submissions WidgetSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, slug])
}

// =========================================================================
// Soft-hold on a candidate booking slot.
// =========================================================================
model SlotHold {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  facilitatorId String
  facilitator   Facilitator @relation(fields: [facilitatorId], references: [id])

  startTime DateTime
  endTime   DateTime

  sessionId String

  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([facilitatorId, startTime])
  @@index([expiresAt])
  @@index([organizationId])
}

// =========================================================================
// WidgetSubmission — denormalized record of a user's booking submission.
// Created at the moment the user clicks "pay for trial lesson".
// =========================================================================
model WidgetSubmission {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  widgetId String
  widget   BookingWidget @relation(fields: [widgetId], references: [id])

  // Full payload of what the user submitted (for audit).
  payload Json

  status        String // PENDING | CONFIRMED | REJECTED
  ip            String?
  userAgent     String?
  acceptedCgvAt DateTime?
  cgvVersion    String?

  resultingScheduledEventId String?
  resultingScheduledEvent   ScheduledEvent? @relation(fields: [resultingScheduledEventId], references: [id])

  submittedAt DateTime @default(now())

  @@index([widgetId])
  @@index([organizationId])
}

// =========================================================================
// Payment — one row per Stripe PaymentIntent we create.
// Mirrors Stripe state via webhooks; the source of truth is Stripe.
// =========================================================================
model Payment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  amountCents Int
  currency    String @default("EUR")

  stripePaymentIntentId String  @unique
  stripeCustomerId      String?

  status  String @default("PENDING") // PENDING | SUCCEEDED | FAILED | REFUNDED
  purpose String // TRIAL_LESSON | ENROLLMENT_BALANCE (extend in PR 6)

  relatedScheduledEventId String?
  relatedScheduledEvent   ScheduledEvent? @relation(fields: [relatedScheduledEventId], references: [id])
  relatedEnrollmentId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([clientId])
  // Payments dashboard sorts/filters by createdAt within an org.
  @@index([organizationId, createdAt])
}

// =========================================================================
// StripeEvent — idempotency log for webhook deliveries.
// NOT tenant-scoped (Stripe events arrive globally; we route by metadata).
// =========================================================================
model StripeEvent {
  id          String    @id // Stripe event id is globally unique
  type        String
  payload     Json
  processedAt DateTime?
  receivedAt  DateTime  @default(now())
}

// =========================================================================
// EnrollmentInvite — single-use token sent by email after a trial lesson
// (LESSON bookingMode only). Lets the student open the "second form" to
// optionally change slot, see the balance with trial credit applied, and
// pay for the full trimester. Consumed when the balance payment succeeds.
// =========================================================================
model EnrollmentInvite {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  scheduledEventId String
  scheduledEvent   ScheduledEvent @relation(fields: [scheduledEventId], references: [id])

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  // Opaque random token used in the email link. Single-use.
  token String @unique

  // PENDING | CONSUMED | EXPIRED | CANCELED
  status String @default("PENDING")

  // Per-invite override of the recurring slot picked at enrollment time.
  // If set, both the quote (getByToken) and activation use these instead of
  // deriving from the trial event. Once-only — UI prevents re-edit.
  overrideWeekday   Int?
  overrideStartTime String?
  rescheduledAt     DateTime?

  expiresAt  DateTime
  sentAt     DateTime?
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([organizationId])
  @@index([scheduledEventId])
  @@index([expiresAt])
}

// =========================================================================
// ScheduledEventRescheduleToken — single-use opaque token, sent in the
// trial-confirmation email. Lets the student open the reschedule page for
// one specific event. Server-side rules (≤1 reschedule, ≥48h before) are
// enforced on apply — the token alone is not authorization to reschedule
// past those windows.
// =========================================================================
model ScheduledEventRescheduleToken {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  scheduledEventId String
  scheduledEvent   ScheduledEvent @relation(fields: [scheduledEventId], references: [id])

  token      String    @unique
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([organizationId])
  @@index([scheduledEventId])
}
